APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Hetzner Object Storage (S3-compatible) — backs the `cold-logs`
# filesystem disk used by the data-lifecycle archive command. Leave
# empty in dev: the archive command short-circuits when no
# subscription has `archive_after_days` set, and tests fake the disk
# via `Storage::fake('cold-logs')`. Endpoint format is
# `https://<region>.your-objectstorage.com` (e.g.
# `https://nbg1.your-objectstorage.com`); path-style URLs are
# required because Hetzner doesn't issue per-bucket DNS names.
HETZNER_S3_ENDPOINT=
HETZNER_S3_REGION=nbg1
HETZNER_S3_BUCKET=
HETZNER_S3_KEY=
HETZNER_S3_SECRET=
HETZNER_S3_USE_PATH_STYLE_ENDPOINT=true

# OpenRouter — backs the per-subscription "ask your logs" chat
# agent (App\Services\Ai\OpenRouterClient). Leave OPENROUTER_API_KEY
# empty in dev unless you're actively iterating on the agent; the
# chat endpoints surface a 503-style notice when the key is missing
# and the test suite binds a fake client through the container, so
# nothing here is required to run `composer test`. APP_URL / APP_NAME
# get sent on every upstream request as the OpenRouter app-ranking
# labels (https://openrouter.ai/rankings) and have no billing effect.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-5-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL="${APP_URL}"
OPENROUTER_APP_TITLE="${APP_NAME} — log agent"

# Agent budget knobs. The daily-token cap is enforced inside
# ChatController::stream BEFORE any OpenRouter call so a runaway tool
# loop can't burn the whole monthly budget; the tool-iteration cap
# bounds the assistant→tool→assistant round-trips per turn.
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_SECONDS=120
AI_TOOL_ITERATION_CAP=6
AI_CONTEXT_MESSAGE_CAP=24
AI_DAILY_TOKEN_CAP_PER_USER=200000

# Sentry — error and performance monitoring (self-hosted at
# sentry-backend.vitrion.dev). Leave empty in dev to disable; the SDK
# no-ops when SENTRY_LARAVEL_DSN is unset.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

VITE_APP_NAME="${APP_NAME}"
